{
  "name": "@pumpkinmc/pumpkin-api-ts",
  "version": "0.1.1",
  "description": "Pumpkin plugin API for TypeScript",
  "license": "MIT OR Apache-2.0",
  "main": "dist/index.ts",
  "types": "dist/index.ts",
  "files": [
    "dist",
    "src/build.js",
    "wit",
    "wit-v0.2"
  ],
  "publishConfig": {
    "tag": "dev"
  },
  "bin": {
    "pumpkin-plugin-build": "src/build.js"
  },
  "scripts": {
    "prepare": "npm run generate:v0.2",
    "generate:v0.1": "jco guest-types wit/v0.1 -n plugin -o dist/bindings --name index",
    "generate:v0.2": "jco guest-types wit-v0.2 -n plugin -o dist/bindings --name index"
  },
  "dependencies": {
    "componentize-qjs": "^0.4.5",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.34.0"
  }
}
